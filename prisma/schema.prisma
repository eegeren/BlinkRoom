generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  ACTIVE
  EXPIRED
  DESTROYED
}

enum ItemType {
  TEXT
  LINK
  IMAGE
  FILE
}

enum ItemAvailability {
  DIRECT
  STORED
  HYBRID
}

enum UploadStatus {
  PENDING
  UPLOADING
  COMPLETED
  ABORTED
  FAILED
}

enum CleanupStatus {
  PENDING
  IN_PROGRESS
  PARTIAL
  COMPLETED
}

enum OneTimeStatus {
  AVAILABLE
  RESERVED
  CONSUMED
}

model Room {
  id             String      @id @default(uuid())
  slug           String      @unique
  createdAt      DateTime    @default(now())
  expiresAt      DateTime
  destroyedAt    DateTime?
  ownerTokenHash String
  cryptoContext  String      @default("")
  accessVersion  Int         @default(1)
  encryptedVerifier String?
  encryptionVersion Int       @default(1)
  status         RoomStatus  @default(ACTIVE)
  cleanupStatus  CleanupStatus @default(PENDING)
  cleanupAttempts Int          @default(0)
  cleanupLastError String?
  cleanupUpdatedAt DateTime?
  autoDestroyWhenEmpty Boolean @default(false)
  autoDestroyEmptySince DateTime?
  directOnly     Boolean      @default(false)
  items          RoomItem[]
  uploadSessions UploadSession[]
  presences      RoomPresence[]
  @@index([status, expiresAt])
  @@index([status, cleanupStatus])
}

model RoomPresence {
  id            String   @id @default(uuid())
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  socketId      String   @unique
  participantId String
  isOwner       Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([roomId, expiresAt])
}

model UploadSession {
  id                String       @id @default(uuid())
  roomId            String
  room              Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  itemId             String       @unique
  senderId           String
  itemType           ItemType
  storageKey         String       @unique
  provider           String
  multipartUploadId String?
  uploadTokenHash    String
  accessVersion      Int          @default(1)
  encryptedMetadata String
  encryptedSize     BigInt
  directDelivered   Boolean      @default(false)
  oneTime            Boolean      @default(false)
  fileFingerprint    String?
  partSize           Int          @default(10485760)
  totalParts         Int          @default(0)
  status             UploadStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  completedAt        DateTime?
  expiresAt          DateTime
  parts              UploadPart[]
  @@index([roomId, status])
  @@index([status, createdAt])
}

model UploadPart {
  id           String        @id @default(uuid())
  sessionId    String
  session      UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  partNumber   Int
  etag         String
  size         Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@unique([sessionId, partNumber])
  @@index([sessionId])
}

model RoomItem {
  id                String   @id @default(uuid())
  roomId            String
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId          String
  type              ItemType
  encryptedPayload  String?
  encryptedMetadata String?
  encryptionVersion Int      @default(1)
  encryptedSize     Int?
  storageKey        String?
  availability      ItemAvailability @default(STORED)
  oneTime           Boolean @default(false)
  oneTimeStatus     OneTimeStatus @default(AVAILABLE)
  consumeTokenHash  String?
  consumeReservedAt DateTime?
  consumedAt        DateTime?
  createdAt         DateTime @default(now())
  @@index([roomId, createdAt])
}

/// Privacy-first, product-wide counters. No room, file, visitor, URL, or
/// request identifiers are stored in this table.
model AnalyticsHourly {
  id              String   @id @default(uuid())
  bucketStart     DateTime @unique
  sessions        BigInt   @default(0)
  pageViews       BigInt   @default(0)
  roomsCreated    BigInt   @default(0)
  filesUploaded   BigInt   @default(0)
  filesDownloaded BigInt   @default(0)
  uploadBytes     BigInt   @default(0)
  downloadBytes   BigInt   @default(0)
  failedUploads   BigInt   @default(0)
  failedDownloads BigInt   @default(0)
  uploadDurationMs BigInt   @default(0)
  downloadDurationMs BigInt @default(0)
  desktopSessions BigInt   @default(0)
  mobileSessions  BigInt   @default(0)
  tabletSessions  BigInt   @default(0)
  chromeSessions  BigInt   @default(0)
  safariSessions  BigInt   @default(0)
  firefoxSessions BigInt   @default(0)
  edgeSessions    BigInt   @default(0)
  otherBrowserSessions BigInt @default(0)
}

/// Anonymous operational event stream. Deliberately contains no foreign keys,
/// request metadata, IP address, user-agent, room id, or file metadata.
model AnalyticsRecentEvent {
  id        String   @id @default(uuid())
  event     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A short-lived SHA-256 digest of a random sessionStorage UUID. It exists
/// only to deduplicate SESSION_STARTED and cannot link events or product data.
model AnalyticsSessionDedupe {
  sessionHash String   @id
  expiresAt   DateTime

  @@index([expiresAt])
}
